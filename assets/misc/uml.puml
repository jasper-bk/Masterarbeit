@startuml PortfolioAIAssistant

!theme plain
skinparam classAttributeIconSize 0
skinparam classFontStyle bold

' External dependencies
class AIAssistant {
  + generate_response(prompt: str): str
}

class yfinance {
  + Ticker(symbol: str): Ticker
}

class Ticker {
  + info: dict
}

' Main class
class PortfolioAIAssistant {
  - __init__(*args, **kwargs)
  + get_quantitative_data(identifier: str): Dict
  + get_qualitative_data(identifier: str): List[str]
  - _get_llm_analysis(identifier: str): str
  - _get_scraped_news(identifier: str): str
  + assess_security(security_data: Dict, portfolio_attributes: Dict): Dict
  + evaluate_portfolio(portfolio: Dict, specific_assets: Optional[List]): Dict
  + evaluate_portfolio_summary(portfolio: Dict): Dict
}

' Data structures (represented as classes for UML)
class Portfolio {
  + assets: Dict[str, Asset]
  + portfolio_evaluation_results: PortfolioEvaluationResults
}

class Asset {
  + ticker: str
  + evaluation_results: EvaluationResults
  + [other_attributes]: any
}

class QuantitativeData {
  + current_price: float
  + pe_ratio: float
  + market_cap: int
  + volume: int
}

class QualitativeData {
  + llm_analysis: str
  + news_info: str
}

class SecurityData {
  + quantitative: QuantitativeData
  + qualitative: QualitativeData
}

class EvaluationResults {
  + urgency: int
  + buy: int
  + sell: int
  + hold: int
  + potential_upside: float
  + potential_downside: float
  + explanation_evaluation: str
}

class PortfolioEvaluationResults {
  + market_summary: str
  + current_opportunities: str
  + current_risks: str
  + other: str
  + explanation_evaluation: str
}

class AssessmentResponse {
  + urgency_to_act: int
  + buy: int
  + sell: int
  + hold: int
  + rationale: str
}

' External modules (utilities)
package "External Libraries" {
  class json {
    + loads(s: str): dict
    + dumps(obj: any): str
  }

  class re {
    + search(pattern: str, string: str): Match
  }

  class time {
    + time(): float
  }

  class dotenv {
    + load_dotenv(): void
  }
}

' Relationships
PortfolioAIAssistant --|> AIAssistant : inherits

PortfolioAIAssistant ..> yfinance : uses
yfinance --> Ticker : creates

PortfolioAIAssistant --> Portfolio : processes
Portfolio *-- Asset : contains
Asset *-- EvaluationResults : has

PortfolioAIAssistant --> QuantitativeData : creates
PortfolioAIAssistant --> QualitativeData : creates
PortfolioAIAssistant --> SecurityData : creates
PortfolioAIAssistant --> AssessmentResponse : creates

SecurityData *-- QuantitativeData : contains
SecurityData *-- QualitativeData : contains

Portfolio *-- PortfolioEvaluationResults : has

PortfolioAIAssistant ..> json : uses
PortfolioAIAssistant ..> re : uses
PortfolioAIAssistant ..> time : uses

' Method details
note right of PortfolioAIAssistant::get_quantitative_data
  Fetches stock data via yfinance:
  - current_price
  - pe_ratio
  - market_cap
  - volume

  Returns empty dict on error
end note

note right of PortfolioAIAssistant::get_qualitative_data
  Combines:
  - LLM analysis of business model
  - News scraping (not implemented)

  Returns formatted string
end note

note right of PortfolioAIAssistant::assess_security
  Uses LLM to analyze investment:
  - Takes quantitative + qualitative data
  - Considers portfolio context
  - Returns JSON with buy/sell/hold %
  - Validates percentages sum to 100
end note

note right of PortfolioAIAssistant::evaluate_portfolio
  Main orchestration method:
  - Iterates through assets
  - Gathers data for each
  - Performs assessments
  - Stores results
  - Generates portfolio summary
end note

note bottom of PortfolioAIAssistant
  evaluate_portfolio_summary():
  Creates portfolio-level analysis:
  - Market summary
  - Opportunities & risks
  - Overall explanation

  Uses LLM with full portfolio context
end note

' Main function
class Main <<function>> {
  + main(): void
}

Main ..> PortfolioAIAssistant : creates
Main ..> json : uses file I/O

note right of Main
  Entry point:
  1. Load sample portfolio JSON
  2. Initialize PortfolioAIAssistant
  3. Evaluate portfolio
  4. Print results
end note

@enduml
