digraph PortfolioChatFlow {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Arial"];

    start [label="ask(session_id, user_message)", fillcolor=lightblue];

    build_ctx [label="build_chat_context_from_portfolio()\n(JSON with derived values)", fillcolor=wheat];

    check_rag [label="use_rag & vectorstore available?", fillcolor=lightcyan, shape=diamond];

    retrieval [label="FAISS Retrieval\n(k relevant documents)\n→ text snippets", fillcolor=gold];
    retrieval_fail [label="RAG retrieval failed\n→ snippets empty", fillcolor=mistyrose, shape=ellipse];

    no_rag [label="RAG disabled\n→ snippets empty", fillcolor=lightgray];

    build_prompt [label="Build prompt:\n• Portfolio context\n• Snippets\n• Conversation history", fillcolor=lightgreen];

    invoke_chain [label="Invoke LLM via LCEL chain\n(RunnableWithMessageHistory)", fillcolor=lightsalmon];

    return_ans [label="Return answer", fillcolor=lightblue];

    // Flows
    start -> build_ctx;
    build_ctx -> check_rag;
    check_rag -> retrieval [label="Yes"];
    check_rag -> no_rag [label="No"];

    retrieval -> build_prompt;
    retrieval -> retrieval_fail [style=dashed, color=red];
    retrieval_fail -> build_prompt;

    no_rag -> build_prompt;

    build_prompt -> invoke_chain;
    invoke_chain -> return_ans;
}
