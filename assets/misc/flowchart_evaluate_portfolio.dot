digraph PortfolioAIFlow {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Arial"];

    // Legend cluster at top
    subgraph cluster_legend {
        label="Legend";
        labelloc="t";
        fontsize=12;
        style=rounded;
        color=black;
        fontname="Arial";

        legend_main [label="Main Flow", fillcolor=lightblue, shape=box];
        legend_data [label="Data Operations", fillcolor=wheat, shape=box];
        legend_llm [label="LLM Evaluation", fillcolor=lightsalmon, shape=box];
        legend_summary [label="Portfolio Summary", fillcolor=gold, shape=box];
        legend_error [label="Error Handling", fillcolor=mistyrose, shape=ellipse];

        // Force horizontal alignment inside legend
        { rank=same; legend_main; legend_data; legend_llm; legend_summary; legend_error; }
    }

    // Entry point
    main [label="Call evaluate_portfolio()", fillcolor=lightblue];

    // Initialization
    init_assistant [label="Initialize PortfolioAIAssistant\n• Provider + Model\n• Ensemble (optional)\n• Finance API config", fillcolor=lightgreen];

    // Portfolio input
    load_portfolio [label="Load or create Portfolio\n(JSON file or object)", fillcolor=lightyellow];

    // Asset loop
    loop_assets [label="Iterate over assets", fillcolor=lightcyan, shape=diamond];

    // Data gathering
    get_quant_data [label="get_quantitative_data()\n• yfinance or Finnhub\n• Prices, ratios, cap", fillcolor=wheat];
    get_qual_data [label="get_qualitative_data()\n• LLM brief\n• Provider context (profile, news)", fillcolor=wheat];

    // Security assessment
    assess_security [label="assess_security()\n• Build context\n• Invoke structured LLM prompt\n• Validate JSON", fillcolor=lightsalmon];

    // Store results
    store_results [label="Persist results in Asset\n+ Save used prompts", fillcolor=lightsteelblue];

    // Portfolio summary
    portfolio_summary [label="evaluate_portfolio_summary()\n• Aggregate asset results\n• Structured portfolio analysis", fillcolor=gold];

    // Final output
    output_json [label="Return Portfolio\n(dict or JSON)\nwith evaluations + prompts", fillcolor=lightblue];

    // Error handling nodes
    error_quant [label="Quant data error\n→ empty dict", fillcolor=mistyrose, shape=ellipse];
    error_qual [label="Qual data error\n→ fallback text", fillcolor=mistyrose, shape=ellipse];
    error_assess [label="Assessment error\n→ default values", fillcolor=mistyrose, shape=ellipse];
    error_summary [label="Summary error\n→ default summary", fillcolor=mistyrose, shape=ellipse];

    // Flow connections
    main -> init_assistant;
    init_assistant -> load_portfolio;
    load_portfolio -> loop_assets;

    loop_assets -> get_quant_data [label="Next asset"];
    loop_assets -> portfolio_summary [label="All done"];

    get_quant_data -> get_qual_data;
    get_quant_data -> error_quant [style=dashed, color=red];

    get_qual_data -> assess_security;
    get_qual_data -> error_qual [style=dashed, color=red];

    assess_security -> store_results;
    assess_security -> error_assess [style=dashed, color=red];

    store_results -> loop_assets;

    portfolio_summary -> output_json;
    portfolio_summary -> error_summary [style=dashed, color=red];
}
